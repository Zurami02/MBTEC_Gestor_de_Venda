<jasperReport name="SubReportPagamento" language="java" columnCount="1" pageWidth="226" pageHeight="1417" columnWidth="210" leftMargin="2" rightMargin="14" topMargin="0" bottomMargin="2" uuid="9b4ef7a0-87bf-4c5f-9467-27e1280b3b7a">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="RelatoriosTests"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<parameter name="idvenda" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT  
SUM(p.valorpagamento) AS valorPago,
SUM(p.valorpagamento) - v.valortotal AS Troco,
v.valortotal - v.taxaiva AS Subtotal,
v.taxaiva  AS IVA,
v.valortotal AS Total,
strftime('%d/%m/%Y %H:%M', p.datapagamento) 
AS datapagamento,
p.formapagamento
FROM pagamento p
LEFT JOIN venda v ON v.idvenda = p.idvenda
WHERE v.idvenda = $P{idvenda}
GROUP BY v.idvenda]]></query>
	<field name="valorPago" class="java.lang.Object">
		<property name="com.jaspersoft.studio.field.name" value="valorPago"/>
		<property name="com.jaspersoft.studio.field.label" value="valorPago"/>
