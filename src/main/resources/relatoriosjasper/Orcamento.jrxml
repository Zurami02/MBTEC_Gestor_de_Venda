<jasperReport name="Orcamento" language="java" columnCount="1" pageWidth="595" pageHeight="842" columnWidth="582" leftMargin="8" rightMargin="5" topMargin="8" bottomMargin="2" uuid="049c5487-e084-440c-8a3c-bba8741d33af">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="RelatoriosTests"/>
	<parameter name="REPORT_CLASS" class="java.lang.Class"/>
	<parameter name="idorcamento" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT o.numero_orcamento,
	o.idorcamento,
	strftime('%d/%m/%Y', o.data) AS data_orc,
	strftime('%H:%M:%S', o.data) AS hora_orc,
	o.total AS totalcomiva,
	o.taxaiva * 100 AS iva,
	o.valor_iva,
	o.total_sem_iva,
	COALESCE( c.nome,o.cliente_nome) AS nomecliente,
	COALESCE( c.nuit,o.nuit) AS nuitcliente,
	p.descricao AS produto,
	u.nome_usuario,
	io.iditemorcamento,
	io.descricaoitem,
	io.tipoitem,
	io.quantidade,
	io.precounitario,
	io.subtotal
FROM orcamento o
	LEFT JOIN item_orcamento io ON 
	 io.idorcamento = o.idorcamento 
	LEFT JOIN produtos p ON 
	 p.idproduto = io.idproduto 
	LEFT JOIN usuario u ON 
	 u.idusuario = o.idusuario 
	LEFT JOIN cliente c ON 
	 c.idcliente = o.idcliente 
WHERE 
	 o.idorcamento = $P{idorcamento}]]></query>
