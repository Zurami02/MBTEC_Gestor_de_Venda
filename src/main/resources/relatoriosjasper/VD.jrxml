<jasperReport name="Venda_Dinheiro" language="java" columnCount="1" pageWidth="226" pageHeight="1417" columnWidth="210" leftMargin="8" rightMargin="8" topMargin="8" bottomMargin="8" uuid="049c5487-e084-440c-8a3c-bba8741d33af">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="RelatoriosTests"/>
	<property name="com.jaspersoft.studio.unit." value="mm"/>
	<parameter name="REPORT_CLASS" class="java.lang.Class"/>
	<parameter name="idvenda" class="java.lang.Integer"/>
	<parameter name="SUBREPORT_DIR" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA[""
]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT v.numerovd,
	v.idvenda,
	strftime('%d/%m/%Y', v.datavenda) AS data_venda,
	strftime('%H:%M:%S', v.datavenda) AS hora_venda,
	v.valortotal,
	v.taxaiva,
	COALESCE( c.nome,v.nomecliente) AS nomecliente,
	COALESCE( c.nuit,v.nuitCliente) AS nuitcliente,
	p.descricao AS produto,
	u.nome_usuario,
	iv.iditemvenda,
	iv.quantidade,
	iv.precounitario,
	iv.desconto,
	iv.quantidade * iv.precounitario - iv.desconto AS subtotal
FROM venda v
	LEFT JOIN itemvenda iv ON 
	 iv.idvenda = v.idvenda 
	LEFT JOIN produtos p ON 
	 p.idproduto = iv.idproduto 
	LEFT JOIN usuario u ON 
	 u.idusuario = v.idusuario 
	LEFT JOIN cliente c ON 
	 c.idcliente = v.idcliente 
WHERE 
	 v.idvenda = $P{idvenda}]]></query>
